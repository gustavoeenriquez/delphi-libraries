unit MP3EncPolyphase;

{
  MP3EncPolyphase.pas — Polyphase analysis filterbank for MP3 Layer III

  Converts blocks of 32 PCM samples into 32 subband samples using:
    1. A 512-sample circular input buffer
    2. The ISO 11172-3 analysis window (512 coefficients)
    3. A 32×64 DCT-IV analysis matrix

  Reference: toots/shine l3subband.c — translated to floating-point Delphi.
  License: CC0 1.0 Universal (Public Domain)
  https://creativecommons.org/publicdomain/zero/1.0/
}

interface

const
  POLY_SUBBANDS = 32;
  POLY_HAN_SIZE = 512;

type
  { State block — initialise once per channel per encoder session }
  TPolyphaseState = record
    X   : array[0..POLY_HAN_SIZE - 1] of Double;  // circular input buffer
    Off : Integer;                                  // current write offset
    FL  : array[0..POLY_SUBBANDS - 1, 0..63] of Double;  // DCT-IV matrix
  end;

  TPCMBlock      = array[0..POLY_SUBBANDS - 1] of Double;
  TSubbandSamples = array[0..POLY_SUBBANDS - 1] of Double;

{ Build the FL DCT-IV matrix; zero the input buffer. }
procedure PolyphaseInit(out AState: TPolyphaseState);

{ Process one block of 32 PCM samples → 32 subband samples.
  ASamples[0] is the most-recently-arrived sample (Shine convention). }
procedure PolyphaseFilter(var AState: TPolyphaseState;
  const ASamples: TPCMBlock; out ASubband: TSubbandSamples);

{ Read-only access to the ISO 11172-3 analysis window for tests }
function PolyphaseEnwindow(AIndex: Integer): Double;

implementation

