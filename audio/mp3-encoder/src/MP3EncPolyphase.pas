// ---------------------------------------------------------------------------

procedure PolyphaseInit(out AState: TPolyphaseState);
var
  i, j: Integer;
begin
  FillChar(AState, SizeOf(AState), 0);

  { DCT-IV analysis matrix: FL[i][j] = cos((2i+1)*(16-j)*PI/64) }
  for i := 0 to POLY_SUBBANDS - 1 do
    for j := 0 to 63 do
      AState.FL[i][j] := Cos((2 * i + 1) * (16 - j) * Pi / 64.0);
end;

procedure PolyphaseFilter(var AState: TPolyphaseState;
  const ASamples: TPCMBlock; out ASubband: TSubbandSamples);
var
  Y : array[0..63] of Double;
  i, j, k, b: Integer;
  v: Double;
begin
  { Store 32 new samples so that ASamples[0] (newest) lands at Off+0,
    matching Shine's convention: wp[0]=newest, wp[31]=oldest. }
  for i := 0 to 31 do
    AState.X[(i + AState.Off) and (POLY_HAN_SIZE - 1)] := ASamples[i];

  { Windowed sum: 8 overlapping 64-sample segments }
  for i := 0 to 63 do begin
    v := 0.0;
    for k := 0 to 7 do
      v := v + AState.X[(AState.Off + i + k * 64) and (POLY_HAN_SIZE - 1)]
               * CEnwindow[i + k * 64];
    Y[i] := v;
  end;

  { Advance circular buffer offset (512 - 32 = 480 positions forward) }
  AState.Off := (AState.Off + 480) and (POLY_HAN_SIZE - 1);

  { DCT-IV matrix multiply: 64 windowed values → 32 subband samples }
  for b := 0 to POLY_SUBBANDS - 1 do begin
    v := 0.0;
    for j := 0 to 63 do
      v := v + AState.FL[b][j] * Y[j];
    ASubband[b] := v;
  end;
end;

function PolyphaseEnwindow(AIndex: Integer): Double;
begin
  Result := CEnwindow[AIndex];
end;

end.
